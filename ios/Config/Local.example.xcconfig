// Copy to Local.xcconfig (gitignored) and set your Apple Developer Team ID
// (developer.apple.com → Membership details, 10 characters). Then run `xcodegen generate`.
DEVELOPMENT_TEAM = ABCDE12345
// Release (TestFlight/App Store) API; Debug always uses localhost. `$()` stops xcconfig reading `//` as a comment.
PHOEBE_API_BASE_URL = https:/$()/api.example.com
