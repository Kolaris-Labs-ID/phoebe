{
  "sourceLanguage": "en",
  "strings": {
    "audio.delete": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete audio"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus audio"
          }
        }
      }
    },
    "audio.delete.blocked": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio hasn't been uploaded. Deleting it now means this meeting can't be transcribed."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio belum terunggah. Menghapusnya sekarang berarti meeting ini tidak bisa ditranskripsi."
          }
        }
      }
    },
    "audio.delete.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio is deleted from this device and the cloud. Transcript, notes, and minutes stay, but audio can't be played again."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio di perangkat dan cloud dihapus. Transkrip, notes, dan MoM tetap ada, tetapi audio tidak bisa diputar lagi."
          }
        }
      }
    },
    "audio.delete.busy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio can't be deleted while transcription is running. Try again when it's done."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio tidak bisa dihapus saat transkripsi berjalan. Coba lagi setelah selesai."
          }
        }
      }
    },
    "audio.delete.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete this meeting's audio?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus audio meeting ini?"
          }
        }
      }
    },
    "conflict.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The latest version (v%1$lld, %2$@) was made on another device or by Regenerate, after the version you edited (v%3$lld)."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Versi terbaru (v%1$lld, %2$@) dibuat di perangkat lain atau oleh Buat ulang, setelah versi yang Anda edit (v%3$lld)."
          }
        }
      }
    },
    "conflict.body.short": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server version (v%1$lld) differs from the version you edited (based on v%2$lld). Your notes are kept on this device until you choose."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Versi di server (v%1$lld) berbeda dengan versi yang Anda edit (dasar v%2$lld). Catatan Anda tetap tersimpan di perangkat sampai Anda memilih."
          }
        }
      }
    },
    "conflict.choose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose version"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih versi"
          }
        }
      }
    },
    "conflict.keepMine": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save my version as a new revision"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan versi saya sebagai revisi baru"
          }
        }
      }
    },
    "conflict.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A newer version exists"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ada versi yang lebih baru"
          }
        }
      }
    },
    "conflict.useServer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use server version, discard my changes"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pakai versi server, buang perubahan saya"
          }
        }
      }
    },
    "conflict.useServer.confirm": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your unsynced changes will be discarded."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perubahan Anda yang belum tersinkron akan dibuang."
          }
        }
      }
    },
