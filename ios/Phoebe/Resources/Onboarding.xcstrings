    "onb.welcome.f1.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For in-person meetings or audio from another device. Calls on this iPhone aren't captured."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk meeting tatap muka atau suara dari perangkat lain. Panggilan di iPhone ini tidak ikut terekam."
          }
        }
      }
    },
    "onb.welcome.f1.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record on iPhone"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekam di iPhone"
          }
        }
      }
    },
    "onb.welcome.f2.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a line to play that moment."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk kalimat untuk memutar audionya."
          }
        }
      }
    },
    "onb.welcome.f2.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Timestamped transcript"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Transkrip bertimestamp"
          }
        }
      }
    },
    "onb.welcome.f3.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit, mark as reviewed, then export to PDF, Word, Markdown, or WhatsApp."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit, tandai sudah ditinjau, lalu ekspor ke PDF, Word, Markdown, atau WhatsApp."
          }
        }
      }
    },
    "onb.welcome.f3.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Minutes ready to share"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "MoM siap dibagikan"
          }
        }
      }
    },
    "onb.welcome.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record meetings. Get minutes you can edit."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekam meeting. Dapatkan MoM yang bisa diedit."
          }
        }
      }
