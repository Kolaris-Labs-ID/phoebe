    "onb.privacy.ai.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You decide the final version. Anything not mentioned is marked \"Not determined\"."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda yang menentukan versi final. Hal yang tidak disebutkan ditandai \"Belum ditentukan\"."
          }
        }
      }
    },
    "onb.privacy.ai.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI writes the draft"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "AI membuat draft"
          }
        }
      }
    },
    "onb.privacy.cloud.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio is sent over an encrypted connection (TLS) and stored encrypted so AI services can transcribe and summarize it."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio dikirim lewat koneksi terenkripsi (TLS) dan disimpan terenkripsi untuk ditranskripsi dan diringkas oleh layanan AI."
          }
        }
      }
    },
    "onb.privacy.cloud.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Processed in the cloud"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Diproses di cloud"
          }
        }
      }
    },
    "onb.privacy.consent.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone mic permission isn't participant consent. Tell everyone before you record."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izin mikrofon iPhone bukan persetujuan peserta. Beri tahu semua orang sebelum merekam."
          }
        }
      }
    },
    "onb.privacy.consent.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tell participants"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beri tahu peserta"
          }
        }
      }
    },
    "onb.privacy.cta": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I understand"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saya mengerti"
          }
        }
      }
    },
    "onb.privacy.mic.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Phoebe records only after you tap Record. The mic never turns on by itself."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Phoebe hanya merekam setelah Anda menekan Rekam. Mikrofon tidak pernah menyala otomatis."
          }
        }
      }
    },
    "onb.privacy.mic.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Microphone"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon"
          }
        }
      }
    },
    "onb.privacy.retention.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud audio is kept for %lld days after the transcript is ready. Notes and minutes are kept until you delete them."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio di cloud disimpan %lld hari setelah transkrip selesai. Notes dan MoM disimpan sampai Anda menghapusnya."
          }
        }
      }
    },
    "onb.privacy.retention.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retention"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Retensi"
          }
        }
      }
    },
    "onb.privacy.retention.unknown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud audio retention is shown before upload."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masa simpan audio di cloud ditampilkan sebelum upload."
          }
        }
      }
    },
    "onb.privacy.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How Phoebe processes audio"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cara Phoebe memproses audio"
          }
        }
      }
    },
    "onb.signin.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account can only see your own meetings."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akun Anda hanya dapat melihat meeting milik Anda."
          }
        }
      }
    },
    "onb.signin.error": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't sign in. Check your connection and try again."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gagal masuk. Periksa koneksi lalu coba lagi."
          }
        }
      }
    },
    "onb.signin.offline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No connection. Signing in needs the internet."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada koneksi. Masuk memerlukan internet."
          }
        }
      }
    },
    "onb.signin.progress": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signing in…"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sedang masuk…"
          }
        }
      }
    },
    "onb.signin.revoked": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your session ended. Sign in again to continue. Recordings on this device are safe."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesi Anda berakhir. Masuk lagi untuk melanjutkan. Rekaman di perangkat tetap aman."
          }
        }
      }
    },
    "onb.signin.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to sync your meetings"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masuk untuk menyinkronkan meeting Anda"
          }
        }
      }
    },
    "onb.skip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
