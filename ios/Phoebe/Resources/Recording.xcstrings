    "rec.error.start": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't start the microphone. Close other apps using audio, then try again."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon tidak dapat dimulai. Tutup aplikasi lain yang memakai audio, lalu coba lagi."
          }
        }
      }
    },
    "rec.error.write": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording paused because the file couldn't be written. Earlier audio is saved. Tap Resume."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekaman dijeda karena file tidak bisa ditulis. Audio sebelumnya sudah tersimpan. Ketuk Lanjutkan."
          }
        }
      }
    },
    "rec.interrupt.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio up to %@ is saved. Tap Resume when the call ends."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio hingga %@ sudah tersimpan. Ketuk Lanjutkan setelah panggilan selesai."
          }
        }
      }
    },
