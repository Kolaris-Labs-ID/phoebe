            "value": "Open Settings"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka Pengaturan"
          }
        }
      }
    },
    "rec.perm.explain.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Phoebe uses the microphone only while you record. You can pause or stop anytime."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Phoebe memakai mikrofon hanya saat Anda merekam. Anda dapat menjeda atau berhenti kapan saja."
          }
        }
      }
    },
    "rec.perm.explain.cta": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lanjut"
          }
        }
      }
    },
    "rec.perm.explain.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow microphone"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izinkan mikrofon"
          }
        }
      }
    },
    "rec.ready.calls": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Phone, WhatsApp, Zoom, or FaceTime calls on this iPhone aren't recorded."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Panggilan telepon, WhatsApp, Zoom, atau FaceTime di iPhone ini tidak ikut terekam."
          }
        }
      }
    },
    "rec.ready.cloud": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio is processed in the cloud and kept for %lld days after the transcript is ready."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio diproses di cloud dan disimpan %lld hari setelah transkrip selesai."
          }
        }
      }
    },
    "rec.ready.cloud.unknown": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio is processed in the cloud. The retention period is shown before upload."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio diproses di cloud. Masa simpan ditampilkan sebelum upload."
          }
        }
      }
    },
