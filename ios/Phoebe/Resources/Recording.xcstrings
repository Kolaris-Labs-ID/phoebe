    "rec.perm.denied.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Microphone access is off. Allow it in Settings to record. You can still import audio."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akses mikrofon dimatikan. Izinkan di Pengaturan untuk merekam. Impor audio tetap bisa digunakan."
          }
        }
      }
    },
    "rec.perm.denied.cta": {
      "extractionState": "manual",
      "localizations": {
