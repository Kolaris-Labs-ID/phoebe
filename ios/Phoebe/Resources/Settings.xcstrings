    "settings.delete.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Access is revoked immediately. Active data is deleted within 30 days; backups expire within 90 days."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akses dicabut segera. Data aktif dihapus dalam maksimal 30 hari; cadangan kedaluwarsa dalam maksimal 90 hari."
          }
        }
      }
    },
