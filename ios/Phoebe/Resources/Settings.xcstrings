    "settings.privacy.noE2E": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio and documents are encrypted in transit and at rest, then processed by AI services on our servers. This isn't end-to-end encryption."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio dan dokumen dienkripsi saat dikirim dan saat disimpan, lalu diproses oleh layanan AI di server. Ini bukan enkripsi end-to-end."
          }
        }
      }
    },
