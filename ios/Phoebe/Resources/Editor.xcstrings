{
  "sourceLanguage": "en",
  "strings": {
    "conflict.banner": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Version v%lld is newer than the one you edited. Your changes stay on this device until you choose."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Versi v%lld lebih baru dari yang Anda edit. Perubahan Anda tetap tersimpan di perangkat sampai Anda memilih."
          }
        }
      }
    },
    "conflict.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The latest version (v%1$lld, %2$@) was made on another device or by Regenerate, after the version you edited (v%3$lld)."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Versi terbaru (v%1$lld, %2$@) dibuat di perangkat lain atau oleh Buat ulang, setelah versi yang Anda edit (v%3$lld)."
          }
        }
      }
    },
    "conflict.keepMine": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save my version as a new revision"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan versi saya sebagai revisi baru"
          }
        }
      }
    },
    "conflict.resolve": {
      "extractionState": "manual",
      "localizations": {
