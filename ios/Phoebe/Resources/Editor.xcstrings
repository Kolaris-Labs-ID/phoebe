            "value": "Choose version"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih versi"
          }
        }
      }
    },
    "conflict.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A newer version exists"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ada versi yang lebih baru"
          }
        }
      }
    },
    "conflict.useServer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use server version, discard my changes"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pakai versi server, buang perubahan saya"
          }
